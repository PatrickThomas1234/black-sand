# === Supabase ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>

# Management API personal access token (account-wide master key — keep secret)
SUPABASE_ACCESS_TOKEN=sbp_xxx

# Project API keys (service_role bypasses RLS — used by the backend ingestion)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# === Apify ===
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxx
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper

# === Whisper (lokale Transkription) ===
# tiny | base | small | medium | large-v3  (größer = besser & langsamer)
WHISPER_MODEL=small

# === LLM (Content-Analyse) ===
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-4-8

# === Dashboard-Login ===
# Variante A (mehrere Nutzer, empfohlen): JSON mit Benutzername → Passwort
DASHBOARD_USERS={"patrick": "blacksand2026", "max": "max-passwort"}
# Variante B (nur ein Passwort, ältere Methode; ignoriert, wenn DASHBOARD_USERS gesetzt ist)
DASHBOARD_PASSWORD=
# Beides leer = offen (lokal).
