# Vorlage für Streamlit-Secrets (Streamlit Community Cloud: im Dashboard unter
# "Settings → Secrets" einfügen; lokal als .streamlit/secrets.toml).
# Werden vom Host auch als Umgebungsvariablen bereitgestellt → os.getenv() funktioniert.

SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_PROJECT_REF = "<project-ref>"
SUPABASE_SERVICE_ROLE_KEY = "eyJ..."
SUPABASE_ANON_KEY = "eyJ..."
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-4-6"
APIFY_TOKEN = "apify_api_..."

# Login fürs Dashboard — mehrere Nutzer (Benutzername = "Passwort")
[users]
patrick = "blacksand2026"
max = "max-passwort"
# Alternativ nur ein Passwort (ignoriert, wenn [users] gesetzt ist):
# DASHBOARD_PASSWORD = "dein-sicheres-passwort"
